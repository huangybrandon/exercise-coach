    {
      "id": "single_leg_balance",
      "type": "balance",
      "title": { "en": "Single-Leg Balance Hold", "zh-TW": "單腳平衡站立" },
      "description": {
        "en": "Stand tall and lift one foot slightly. Use a chair for support if needed.",
        "zh-TW": "站直，輕輕抬起一隻腳。如需要可扶著椅子。"
      },
      "cues": {
        "en": ["Look forward", "Keep hips level", "Breathe steadily"],
        "zh-TW": ["看向前方", "骨盆保持水平", "穩定呼吸"]
      },
      "safety": {
        "en": "Hold onto a chair if balance feels unsteady.",
        "zh-TW": "若覺得不穩，請扶著椅子。"
